<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.cabinet.controller.admin.StatistiquesController"
      spacing="15" style="-fx-padding: 20; -fx-background-color: #f5f5f5;">
    
    <Label text="📊 Statistiques du Cabinet" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    
    <HBox spacing="15">
        <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-border-radius: 5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5,0,0,2);">
            <Label text="Patients" style="-fx-text-fill: #666;"/>
            <Label fx:id="labelPatients" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
        </VBox>
        
        <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-border-radius: 5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5,0,0,2);">
            <Label text="Médecins" style="-fx-text-fill: #666;"/>
            <Label fx:id="labelMedecins" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #9b59b6;"/>
        </VBox>
        
        <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-border-radius: 5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5,0,0,2);">
            <Label text="RDV aujourd'hui" style="-fx-text-fill: #666;"/>
            <Label fx:id="labelRdvAujourdhui" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2ecc71;"/>
        </VBox>
        
        <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-border-radius: 5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5,0,0,2);">
            <Label text="Ordonnances" style="-fx-text-fill: #666;"/>
            <Label fx:id="labelOrdonnances" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #e67e22;"/>
        </VBox>
    </HBox>
    
    <HBox spacing="20">
        <VBox style="-fx-pref-width: 300;">
            <PieChart fx:id="chartSimple" style="-fx-pref-height: 250;"/>
        </VBox>
        
        <VBox style="-fx-pref-width: 400;">
            <Label text="Derniers RDV" style="-fx-font-weight: bold; -fx-padding: 0 0 5 0;"/>
            <TableView fx:id="tableSimple" style="-fx-pref-height: 250;">
                <columns>
                    <TableColumn text="Date" fx:id="colDateSimple" style="-fx-pref-width: 120;"/>
                    <TableColumn text="Patient" fx:id="colPatientSimple" style="-fx-pref-width: 150;"/>
                    <TableColumn text="Statut" fx:id="colStatutSimple" style="-fx-pref-width: 100;"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>
    
    <HBox spacing="10" style="-fx-padding: 10 0 0 0;">
        <Button fx:id="btnRafraichir" text="🔄 Rafraîchir" onAction="#handleRafraichir" 
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 8 15;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnFermer" text="✕ Fermer" onAction="#handleFermer" 
                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 8 15;"/>
    </HBox>
    
</VBox>